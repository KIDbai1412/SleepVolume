<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="22dp"
        android:paddingRight="18dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="放一阵，静一阵，每轮更轻一点，直到你睡着。"
            android:textColor="@color/sub"
            android:textSize="13sp" />

        <!-- 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/status_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未开始"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--:--"
                android:textColor="@color/text"
                android:textSize="46sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="@color/accent_deep"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/status_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="当前媒体音量 --"
                android:textColor="@color/sub"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="16dp"
            android:paddingRight="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="循环设置"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 播放时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="单轮播放时长" />

                    <TextView
                        android:id="@+id/lbl_play"
                        style="@style/Value"
                        android:text="5 分钟" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_play"
                    style="@style/Slider" />
            </LinearLayout>

            <!-- 静默时长 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="静默时长" />

                    <TextView
                        android:id="@+id/lbl_silent"
                        style="@style/Value"
                        android:text="5 分钟" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_silent"
                    style="@style/Slider" />
            </LinearLayout>

            <!-- 每轮衰减 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="每轮降低（按起始音量）" />

                    <TextView
                        android:id="@+id/lbl_step"
                        style="@style/Value"
                        android:text="34%" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_step"
                    style="@style/Slider" />
            </LinearLayout>

            <!-- 轮数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="最多循环轮数" />

                    <TextView
                        android:id="@+id/lbl_cycles"
                        style="@style/Value"
                        android:text="6 轮" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_cycles"
                    style="@style/Slider" />
            </LinearLayout>

            <!-- 淡出 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="淡出时长（变安静）" />

                    <TextView
                        android:id="@+id/lbl_fade_out"
                        style="@style/Value"
                        android:text="8 秒" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_fade_out"
                    style="@style/Slider" />
            </LinearLayout>

            <!-- 淡入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="淡入时长（恢复播放）" />

                    <TextView
                        android:id="@+id/lbl_fade_in"
                        style="@style/Value"
                        android:text="8 秒" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_fade_in"
                    style="@style/Slider" />
            </LinearLayout>

            <!-- 总时长上限 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:text="总时长上限" />

                    <TextView
                        android:id="@+id/lbl_cap"
                        style="@style/Value"
                        android:text="不限" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_cap"
                    style="@style/Slider" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_alt"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text="--"
                android:textColor="@color/sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start"
                style="@style/BtnPrimary"
                android:text="@string/start" />

            <Button
                android:id="@+id/btn_stop"
                style="@style/BtnStop"
                android:layout_marginLeft="10dp"
                android:enabled="false"
                android:text="@string/stop" />
        </LinearLayout>

        <!-- 后台权限提示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="让它别被系统杀掉"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="点下面的按钮，允许它在后台一直运行。小米手机还要去「设置 → 应用设置 → 应用管理 → 睡眠音量 → 省电策略」里选「无限制」，并允许「自启动」。"
                android:textColor="@color/sub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_battery"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_stop"
                android:stateListAnimator="@null"
                android:text="关闭电池优化"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="说明：本应用只调节系统媒体音量，不控制任何播放器的播放状态。开始前请先把媒体音量调到你想开始的档位。"
            android:textColor="@color/sub"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
